<% const data = catalog || {}; %>
<section class="content-section" data-section="catalog">
  <% if (data.label) { %>
    <p class="eyebrow"><%= data.label %></p>
  <% } %>
  <div class="section-heading">
    <h2><%= data.title || '' %></h2>
    <% if (data.subtitle) { %>
      <p><%= data.subtitle %></p>
    <% } %>
  </div>

  <% if (Array.isArray(data.items) && data.items.length) { %>
    <div class="card-grid two">
      <% data.items.forEach(function(item) { %>
        <article class="product-card">
          <div class="product-head">
            <div>
              <% if (item.badge) { %>
                <span class="badge"><%= item.badge %></span>
              <% } %>
              <h3><%= item.name %></h3>
            </div>
            <strong><%= item.currency %><%= item.price %></strong>
          </div>
          <p><%= item.description %></p>
          <% if (Array.isArray(item.tags) && item.tags.length) { %>
            <div class="tag-row">
              <% item.tags.forEach(function(tag) { %>
                <span><%= tag %></span>
              <% }) %>
            </div>
          <% } %>
          <% if (Array.isArray(item.features) && item.features.length) { %>
            <ul class="feature-list">
              <% item.features.forEach(function(feature) { %>
                <li><%= feature %></li>
              <% }) %>
            </ul>
          <% } %>
          <button class="button primary js-add-to-cart" type="button" data-cart-action="add" data-product-id="<%= item.id %>">
            <span class="button-symbol">+</span>
            <span>Add to cart</span>
          </button>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<% const nav = navbar || {}; %>
<nav class="site-nav" aria-label="Primary navigation">
  <div class="container nav-inner">
    <a class="brand-lockup" href="/">
      <strong><%= nav.brand || 'Home' %></strong>
      <% if (nav.tagline) { %>
        <span><%= nav.tagline %></span>
      <% } %>
    </a>

    <% if (Array.isArray(nav.links) && nav.links.length) { %>
      <div class="nav-links">
        <% nav.links.forEach(function(link) { %>
          <a href="<%= link.path %>" class="<%= currentPath === link.path ? 'is-active' : '' %>">
            <%= link.name %>
          </a>
        <% }) %>
      </div>
    <% } %>

    <div class="nav-actions">
      <button class="button icon-button js-open-cart" type="button" aria-label="Open cart">
        <span>Cart</span>
        <span class="cart-count js-cart-count">0</span>
      </button>
      <% if (nav.cta) { %>
        <a class="button primary" href="<%= nav.cta.path || '#' %>"><%= nav.cta.label %></a>
      <% } %>
    </div>
  </div>
</nav>
